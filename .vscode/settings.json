{
  "chat.useClaudeMdFile": false,
  "chat.useClaudeHooks": false,
  "chat.tools.terminal.autoApprove": {
    "/^npm (test|run (lint|check|typecheck|build|test:app|test:server))\\b/": true,
    "/^git push\\b/": false
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "cucumber.features": ["e2e/features/**/*.feature", "src/**/*.feature"],
  "cucumber.glue": ["e2e/steps/**/*.ts", "src/**/*.feature.spec.ts"],
  "files.exclude": {
    ".features-gen": true
  },
  "search.exclude": {
    ".features-gen": true
  },
  "prettier.documentSelectors": ["**/*.feature"],
  "[cucumber]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "chat.tools.urls.autoApprove": {
    "https://mcp.context7.com/*": true
  },
  // Sandbox (VS Code 1.140). The agent's terminal commands run in it.
  // macOS: VS Code already lets the sandbox read nvm, fnm, Volta, asdf and mise Node installs.
  // allowRead adds the npm and Angular CLI config files, allowWrite the npm log folder.
  // Known limit: VS Code always lets the sandbox read the workspace, so denyRead does not hide
  // server/.env from a terminal command. The preToolUse hook in .github/hooks is the guard here.
  "chat.agent.sandbox.enabled": "on",
  "chat.agent.sandbox.enabledWindows": "on",
  "chat.agent.sandbox.allowUnsandboxedCommands": false,
  "chat.agent.sandbox.fileSystem.mac": {
    "denyRead": [
      "./server/.env"
    ],
    "allowRead": [
      "~/.npmrc",
      "~/.angular",
      "~/.angular-config.json"
    ],
    "allowWrite": [
      "~/.npm",
      "~/.angular"
    ]
  },
  "chat.agent.sandbox.fileSystem.linux": {
    "denyRead": [
      "./server/.env"
    ]
  },
  "chat.agent.sandbox.fileSystem.windows": {
    "denyRead": [
      "./server/.env"
    ]
  }
}
