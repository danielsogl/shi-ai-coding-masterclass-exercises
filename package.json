{
  "name": "shi-ai-coding-masterclass-exercises",
  "version": "1.2.0",
  "private": true,
  "description": "Task board app for the AI Coding Master Class hands-on exercises.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "concurrently -k -n api,app -c blue,magenta \"npm:start:api\" \"npm:start:app\"",
    "start:api": "node --env-file-if-exists=server/.env --watch server/src/index.ts",
    "start:app": "ng serve",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc -p server/tsconfig.json && tsc -p e2e/tsconfig.json",
    "lint": "eslint . && gplint e2e/features src",
    "test": "npm run test:app && npm run test:server --",
    "test:app": "ng test --watch=false",
    "test:server": "vitest run --config server/vitest.config.ts",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:steps": "node scripts/e2e-steps.mjs",
    "test:affected": "node scripts/test-affected.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "preflight": "node scripts/preflight.mjs",
    "accept:e1": "node scripts/accept-e1.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "express": "^5.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^8.0.1",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@ngrx/eslint-plugin": "^22.0.1",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "angular-eslint": "^22.7.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "gplint": "^2.6.2",
    "jsdom": "^31.0.1",
    "ng-mocks": "^14.18.6",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.10.1",
    "prettier-plugin-gherkin": "^4.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
